# Shared secret for POST /webhooks/lead (min 16 chars). Generate: openssl rand -hex 24
WEBHOOK_SECRET=
# SQLite file shared by the webhook process and the MCP server (default: data/gtm.db in the repo)
GTM_DB_PATH=
HOST=127.0.0.1
PORT=3000

# AI SDR drafter: local (LM Studio, default) | template (offline) | anthropic (reserved for Phase 5c)
SDR_DRAFTER=local
SDR_LOCAL_BASE_URL=
SDR_LOCAL_MODEL=
# Set to 1 only if you really mean to send lead data to a non-loopback model server
SDR_ALLOW_REMOTE_LLM=
